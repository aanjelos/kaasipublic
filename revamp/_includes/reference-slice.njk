{% from "screen-image.njk" import screen %}
<div class="reference-slice">
<section class="scene-hero" aria-labelledby="scene-title">
  <div class="scene-intro"><h1 id="scene-title">The finance power tool.<br>For serious Sri Lankans.</h1><p>Complete control. Every feature free.</p><div class="scene-actions"><a class="primary" href="https://app.kaasi.com.lk/">Launch Kaasi</a><a class="scene-secondary" href="#features">Take a look<span aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 4v16m-6-6 6 6 6-6"/></svg></span></a></div></div>
  <div class="screen-stage container" aria-label="Kaasi product screens">
    <div class="screen-composition"><div class="main-screen"><picture><source media="(max-width:600px)" srcset="/assets/screens/balances-mobile.png"><img src="/assets/screens/dashboard.png" alt="Kaasi dashboard with illustrative account balances and everyday transactions" width="2880" height="1800" fetchpriority="high"></picture></div><figure class="budget-float"><img src="/assets/screens/budgets.png" alt="Kaasi category budgets for groceries, getting around and eating out" width="821" height="626"></figure><div class="offline-note"><img src="/img/LogoIcon.svg" alt="" width="28" height="28"><div><strong>On your device.</strong><span>Cloud backup when you choose.</span></div></div></div>
  </div>
</section>
<section class="first-feature" id="features" aria-labelledby="first-feature-title"><div class="container">
  <div class="first-feature-head"><h2 id="first-feature-title">From the everyday<br>to the whole month.</h2></div>
  <div class="feature-theatre"><div class="feature-controls"><a class="feature-step" href="#scene-daily" data-scene="daily" aria-current="true"><span>Track your spending</span><small>Cash, bank accounts and transfers.</small><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a><a class="feature-step" href="#scene-budget" data-scene="budget"><span>Keep a budget</span><small>Spending limits you can follow.</small><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a><a class="feature-step" href="#scene-month" data-scene="month"><span>Review your month</span><small>Categories, comparisons and reports.</small><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a><a class="feature-step" href="#scene-install" data-scene="install"><span>Install as an app</span><small>On your phone or computer.</small><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a><a class="feature-step" href="#scene-debts" data-scene="debts"><span>Debts & receivables</span><small>What you owe. What you’re owed.</small><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a><a class="feature-step" href="#scene-connected" data-scene="connected"><span>Offline or online</span><small>Offline tracking. Sync across devices.</small><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a></div>
