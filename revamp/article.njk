---
layout: base.njk
pagination:
  data: posts
  size: 1
  alias: post
permalink: "{{ post.url }}"
eleventyComputed:
  title: "{{ post.title | safe }} | Kaasi"
  excerpt: "{{ post.excerpt | safe }}"
  image: "{{ post.image }}"
---
<article class="reading container"><header><a class="article-back" href="/blog/"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24"><path d="m14.5 7-5 5 5 5"/></svg> Back to the Blog Wallet</a><h1>{{ post.title | keepLastWords }}</h1><p class="deck">{{ post.excerpt | keepLastWords }}</p><div class="article-meta"><span>{{ post.author }}</span><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time><span>{{ post.minutes }} min read</span></div></header><img class="cover" src="{{ post.image }}" alt="{{ post.title }}" width="1200" height="675" fetchpriority="high"><div class="reading-grid"><aside><nav aria-label="Article sections">{% for h in post.headings %}{% if h.level == '2' %}<a href="#{{ h.id }}">{{ h.title }}</a>{% endif %}{% endfor %}</nav></aside><div class="prose">{{ post.html | safe }}</div></div><div class="article-end"><div class="article-sharing"><p>Share this article</p><nav aria-label="Share this article"><a href="https://twitter.com/intent/tweet?url={{ ('https://www.kaasi.com.lk' ~ post.url) | urlencode }}&amp;text={{ post.title | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on X" title="Share on X"><i class="fa-brands fa-x-twitter" aria-hidden="true"></i></a><a href="https://www.facebook.com/sharer/sharer.php?u={{ ('https://www.kaasi.com.lk' ~ post.url) | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" title="Share on Facebook"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a><a href="https://www.linkedin.com/sharing/share-offsite/?url={{ ('https://www.kaasi.com.lk' ~ post.url) | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" title="Share on LinkedIn"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i></a><a href="https://api.whatsapp.com/send?text={{ post.title | urlencode }}%20{{ ('https://www.kaasi.com.lk' ~ post.url) | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp" title="Share on WhatsApp"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></a><button type="button" data-copy-article aria-label="Copy article link" title="Copy article link" hidden><i class="fas fa-link" aria-hidden="true"></i></button></nav><span class="share-status" role="status"></span></div><a class="primary" href="https://app.kaasi.com.lk/">Try Kaasi</a></div></article><section class="container related"><h2>Keep reading.</h2><div class="article-grid">{% for related in posts | related(post.slug) %}<article><a href="{{ related.url }}"><img src="{{ related.image }}" alt="" loading="lazy" width="720" height="450"><h3>{{ related.title }}</h3></a></article>{% endfor %}</div></section>
